# Heritage Bank - Backend Environment Variables
# Copy this to .env for local development
# For Railway/production, set these in the Railway Variables tab

# Server
PORT=3001
NODE_ENV=development

# Database (TiDB Cloud)
DB_HOST=gateway02.us-east-1.prod.aws.tidbcloud.com
DB_PORT=4000
DB_USER=JFuLJ45NfRfBSN9.root
DB_PASSWORD=
DB_NAME=S7YJ2XbutEnzhih9Qut8LJ
DB_SSL=true

# Auth — generate a strong secret for production:
# node -e "require('crypto').randomBytes(64).toString('hex')"
JWT_SECRET=dev-jwt-secret-change-me

# Admin Account (created on first boot)
ADMIN_EMAIL=admin@heritagebank.com
ADMIN_PASSWORD=

# Card Encryption (AES-256-GCM)
CARD_ENCRYPTION_KEY=

# Optional
CORS_ORIGIN=
NEWS_API_KEY=
