{
  "version": 2,
  "framework": null,
  "installCommand": "echo 'Skipping install for static frontend'",
  "buildCommand": "echo 'Static frontend only'",
  "outputDirectory": "public",
  "builds": [
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/(.*\\..*)",
      "dest": "/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
